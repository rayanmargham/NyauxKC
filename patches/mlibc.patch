diff --git a/sysdeps/nyaux/riscv64/cp_syscall.S b/sysdeps/nyaux/riscv64/cp_syscall.S
new file mode 100644
index 0000000..59d5543
--- /dev/null
+++ b/sysdeps/nyaux/riscv64/cp_syscall.S
@@ -0,0 +1,30 @@
+.section .text
+.global __mlibc_do_asm_cp_syscall
+.global __mlibc_syscall_begin
+.global __mlibc_syscall_end
+.type __mlibc_do_asm_cp_syscall, "function"
+__mlibc_do_asm_cp_syscall:
+	sd a7, -8(sp)
+	mv a7, a0
+	mv a0, a1
+	mv a1, a2
+	mv a2, a3
+	mv a3, a4
+	mv a4, a5
+	mv a5, a6
+	ld a6, -8(sp) // a7
+	lw t0, -104(tp) // Tcb::cancelBits. See asserts in tcb.hpp.
+__mlibc_syscall_begin:
+	// tcbCancelEnableBit && tcbCancelTriggerBit
+	li t1, (1 << 0) | (1 << 2)
+	and t0, t0, t1
+	beq t0, t1, cancel
+	ecall
+__mlibc_syscall_end:
+	ret
+
+cancel:
+	call __mlibc_do_cancel
+	unimp
