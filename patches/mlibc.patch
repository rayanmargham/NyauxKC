diff --git a/options/ansi/x86_64/strcmp.cpp b/options/ansi/x86_64/strcmp.cpp
index 6ebd3b3..04f074c 100644
--- a/options/ansi/x86_64/strcmp.cpp
+++ b/options/ansi/x86_64/strcmp.cpp
@@ -6,6 +6,7 @@
 #include <mlibc/string.hpp>
 #include <mlibc/features.hpp>
 
+#if 0
 extern "C" [[gnu::visibility("protected")]]
 __attribute__((target("sse2")))
 int __mlibc_strcmp_sse2(const char *s1, const char *s2) {
@@ -171,3 +172,20 @@ strcmp_signature __mlibc_resolve_strcmp() {
 #if MLIBC_IFUNCS_SUPPORTED
 extern "C" int strcmp(const char *a, const char *b) __attribute__((ifunc("__mlibc_resolve_strcmp")));
 #endif
+#else
+int strcmp(const char *a, const char *b) {
+	size_t i = 0;
+	while(true) {
+		unsigned char a_byte = a[i];
+		unsigned char b_byte = b[i];
+		if(!a_byte && !b_byte)
+			return 0;
+		// If only one char is null, one of the following cases applies.
+		if(a_byte < b_byte)
+			return -1;
+		if(a_byte > b_byte)
+			return 1;
+		i++;
+	}
+}
+#endif
